# =============================================================================
# Yapper — environment variables
# Copy to `.env` (gitignored): cp .env.example .env
# Defaults below are safe for local docker-compose development.
# =============================================================================

# ----- Application -----------------------------------------------------------
# development | staging | production
APP_ENV=development

# ----- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=yapper
POSTGRES_PASSWORD=yapper
POSTGRES_DB=yapper
POSTGRES_PORT=5432

# ----- Backend (Go API) ------------------------------------------------------
BACKEND_PORT=8080
# Used by goose/sqlc from the host (e.g. `make migrate-up`):
DATABASE_URL=postgres://yapper:yapper@localhost:5432/yapper?sslmode=disable
# Comma-separated origins allowed to send credentialed XHR/WS to the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true in production so the session cookie is only sent over HTTPS.
COOKIE_SECURE=false
# Comma-separated emails promoted to admin at API startup.
# ADMIN_EMAILS=admin@example.com

# ----- Media storage (S3-compatible) -----------------------------------------
# Dev: local MinIO. Prod: Cloudflare R2 — point S3_ENDPOINT at
# <account>.r2.cloudflarestorage.com and use R2 access/secret keys.
S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yapper-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/yapper-media
S3_USE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----- Mail (SMTP) -----------------------------------------------------------
# Dev: Mailpit (local SMTP trap, UI at http://localhost:8025).
# Prod with Resend (https://resend.com): use SMTP transport —
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASSWORD=<your-resend-api-key>
#   SMTP_TLS_MODE=tls
#   SMTP_FROM=Yapper <no-reply@your-verified-domain>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Yapper <no-reply@yapper.local>
SMTP_TLS_MODE=none
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----- Site branding ---------------------------------------------------------
SITE_NAME=Yapper
# Used to build links in outgoing emails (verification / password reset).
SITE_BASE_URL=http://localhost:3000/ru

# ----- Frontend (Next.js) ----------------------------------------------------
FRONTEND_PORT=3000
# Base URL the browser uses to reach the API (prod: https://<domain> via Caddy).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public site URL used for canonical links / metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL the Next.js server uses for SSR fetches (compose: http://backend:8080).
INTERNAL_API_URL=http://localhost:8080
