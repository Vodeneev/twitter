# =============================================================================
# Yapper — production environment (copy to deploy/.env.prod on the server)
# chmod 600 deploy/.env.prod
# =============================================================================

# Public domain (Cloudflare-managed DNS, orange cloud). Caddy gets TLS for it.
SITE_DOMAIN=yapper.example.com
SITE_NAME=Yapper

# ----- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=yapper
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=yapper

# ----- Admins ----------------------------------------------------------------
# Managed via GitHub secret/variable ADMIN_EMAILS by the deploy workflow.
ADMIN_EMAILS=

# ----- Mail via Resend (SMTP transport) --------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_TLS_MODE=tls
SMTP_FROM=Yapper <no-reply@your-verified-domain>

# ----- Media via Cloudflare R2 ------------------------------------------------
# Create an R2 bucket and an S3 API token. Expose the bucket via a public
# r2.dev URL or a custom domain and put it in S3_PUBLIC_BASE_URL.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=yapper-media
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_PUBLIC_BASE_URL=https://media.yapper.example.com
S3_USE_PATH_STYLE=false
